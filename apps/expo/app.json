{
  "expo": {
    "name": "MediaSFU Live Auction",
    "slug": "mediasfu-live-auction",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.mediasfu.examples.liveauction",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "mediasfu-reactnative-expo/plugins/withMediaSFUWebRTC",
        {
          "cameraPermission": "Allow MediaSFU Live Auction to use your camera.",
          "microphonePermission": "Allow MediaSFU Live Auction to use your microphone."
        }
      ],
      "expo-audio"
    ]
  }
}
